# Copy this file to library/.env and fill in the real values.
#
#   cp library/.env.sample library/.env
#
# library/.env holds live credentials: it is git ignored, must never be committed,
# and is created once per server. It is an alternative to library/config.php - use
# whichever suits the host. When both exist, .env wins.
#
# Order of precedence, highest first:
#   1. real environment variables (Plesk PHP-FPM "env[...]" directives, Docker, CI)
#   2. this file
#   3. library/config.php
#
# Format: KEY=value, one per line. Blank lines and lines starting with # are
# ignored. Surrounding single or double quotes are stripped, so a password
# containing spaces or # can be written as PASS="my secret#value".

# --- Database (required) ---------------------------------------------------
QUIZ_DB_HOST=localhost
QUIZ_DB_USER=
QUIZ_DB_PASS=
QUIZ_DB_NAME=

# --- Site (required) -------------------------------------------------------
# Full base URL including the trailing slash, e.g. https://admin.example.com/
QUIZ_DOMAIN_URL=

# Signs login tokens. Use a long random string, e.g. from: openssl rand -hex 32
# Changing this signs everyone out, so set it once and leave it alone.
QUIZ_JWT_SECRET=

# --- Email for teacher invitations (optional) ------------------------------
# Without an SMTP host, invitations are shown as links to copy instead of sent.
UQUIZ_SMTP_HOST=
UQUIZ_SMTP_PORT=587
UQUIZ_SMTP_USER=
UQUIZ_SMTP_PASS=
UQUIZ_SMTP_TLS=1
# 0 = accept the mail server's certificate even if it is for another host name
UQUIZ_SMTP_VERIFY=1
# Sender address; defaults to no-reply@<your domain>
UQUIZ_SMTP_FROM=
# 1 = fall back to PHP mail() when no SMTP host is set
UQUIZ_MAIL_FALLBACK=0
